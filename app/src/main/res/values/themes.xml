<resources>
    <style name="Theme.PontosVoith" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/voith_blue</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- V5: tela invisível usada pelo widget -->
    <style name="Theme.PontosVoith.Transparente" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
